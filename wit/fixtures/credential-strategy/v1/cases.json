            "error": {
              "code": "protocol_error",
              "retryable": false,
              "requests": 1,
              "storage_unchanged": true
            }
          }
        }
      ]
    },
    {
      "id": "unrelated-client-error-is-terminal",
      "description": "A non-transient client error that is not invalid_grant is terminal.",
      "credential": {
        "access_token": "at-stored",
        "refresh_token": "rt-stored",
        "expiry": {
          "window_delta_ms": 0
        }
      },
      "http": [
        {
          "status": 400,
          "json": {
            "error": "invalid_client"
          }
        }
      ],
      "steps": [
        {
          "call": "resolve",
