            }
          }
        }
      ]
    },
    {
      "id": "missing-expires-in-follows-policy",
      "description": "A response without expires_in yields exactly the policy-declared expiry.",
      "credential": {
        "access_token": "at-stored",
        "refresh_token": "rt-stored",
        "expiry": {
          "window_delta_ms": 0
        }
      },
      "http": [
        {
          "status": 200,
          "json": {
            "access_token": "at-new",
            "refresh_token": "rt-new"
          }
        }
      ],
      "steps": [
        {
          "call": "resolve",
          "expect": {
            "ok": {
              "requests": 1,
              "leased_access_token": "at-new",
              "persisted": {
                "access_token": "at-new",
                "expiry": "per_policy"
              }
            }
          }
        }
      ]
    },
    {
      "id": "explicit-rotate-persists-lifecycle-state",
      "description": "rotate() refreshes a fresh token and persists the complete new state.",
      "credential": {
        "access_token": "at-stored",
        "refresh_token": "rt-stored",
        "expiry": {
          "window_delta_ms": 3600000
        }
      },
      "http": [
        {
          "status": 200,
          "json": {
            "access_token": "at-rot",
            "refresh_token": "rt-rot",
            "expires_in": 172800
          }
        }
      ],
      "steps": [
        {
          "call": "rotate",
          "expect": {
            "ok": {
              "requests": 1,
              "refresh_token_sent": "rt-stored",
              "persisted": {
                "access_token": "at-rot",
                "refresh_token": "rt-rot",
                "expiry": {
                  "in_ms": 172800000
                }
              }
            }
          }
        },
        {
          "call": "resolve",
          "expect": {
            "ok": {
              "requests": 0,
              "leased_access_token": "at-rot"
            }
          }
        }
      ]
    },
    {
      "id": "failed-rotate-keeps-persisted-state",
      "description": "A failed rotate neither corrupts nor drops the usable credential.",
