        "refresh_token": "rt-stored",
        "expiry": {
          "window_delta_ms": 0
        }
      },
      "http": [
        {
          "status": 200,
          "hex": "fffefd"
        }
      ],
      "steps": [
        {
          "call": "resolve",
          "expect": {
            "error": {
              "code": "protocol_error",
              "retryable": false,
              "requests": 1,
              "storage_unchanged": true
            }
          }
        }
      ]
    },
    {
      "id": "missing-access-token-is-protocol-error",
