{
  "contract": "kinetix.plugin.capability-security",
  "schema_version": 1,
  "setup": {
    "credential": {"provider": "fixture", "account": "account-a", "secret": "fixture-secret-not-a-real-credential", "hosts": ["api.fixture.invalid"]},
    "other_account": "account-b",
    "other_plugin": "dev.kinetix.other-fixture",
    "other_plugin_storage": {"shared": [112, 114, 105, 118, 97, 116, 101]},
    "http_response_bytes": 17,
    "now_unix_millis": 1700000000123,
    "storage_key_bytes": 256,
    "storage_entries": 1024,
    "log_record_bytes": 1024,
    "log_invocation_bytes": 4096
  },
  "approvals": {
    "none": {"network_hosts": [], "credential_scopes": [], "credential_read": false, "storage_bytes": 0, "log": false, "clock": false},
    "scoped": {"network_hosts": ["api.fixture.invalid", "other.fixture.invalid", "*.wild.fixture.invalid"], "credential_scopes": ["provider:fixture"], "credential_read": false, "storage_bytes": 16, "log": true, "clock": true},
    "plaintext": {"network_hosts": ["api.fixture.invalid"], "credential_scopes": ["provider:fixture"], "credential_read": true, "storage_bytes": 16, "log": true, "clock": true}
  },
  "cases": [
    {"id": "http-undeclared", "package": "denied", "approval": "scoped", "operation": {"op": "http", "url": "https://api.fixture.invalid/"}, "expect": {"outcome": "deny", "http_requests": 0}},
    {"id": "http-unapproved", "package": "scoped", "approval": "none", "operation": {"op": "http", "url": "https://api.fixture.invalid/"}, "expect": {"outcome": "deny", "http_requests": 0}},
    {"id": "http-approved", "package": "scoped", "approval": "scoped", "operation": {"op": "http", "url": "https://API.FIXTURE.INVALID/", "bytes": 16}, "expect": {"outcome": "allow", "http_requests": 1, "body_bytes": 16, "truncated": true}},
    {"id": "http-suffix-confusion", "package": "scoped", "approval": "scoped", "operation": {"op": "http", "url": "https://api.fixture.invalid.attacker.invalid/"}, "expect": {"outcome": "deny", "http_requests": 0}},
    {"id": "http-wildcard-child", "package": "scoped", "approval": "scoped", "operation": {"op": "http", "url": "https://a.wild.fixture.invalid/"}, "expect": {"outcome": "allow", "http_requests": 1}},
    {"id": "http-wildcard-apex", "package": "scoped", "approval": "scoped", "operation": {"op": "http", "url": "https://wild.fixture.invalid/"}, "expect": {"outcome": "deny", "http_requests": 0}},
    {"id": "http-insecure", "package": "scoped", "approval": "scoped", "operation": {"op": "http", "url": "http://api.fixture.invalid/"}, "expect": {"outcome": "deny", "http_requests": 0}},
    {"id": "http-nondefault-port", "package": "scoped", "approval": "scoped", "operation": {"op": "http", "url": "https://api.fixture.invalid:8443/"}, "expect": {"outcome": "deny", "http_requests": 0}},
    {"id": "http-userinfo", "package": "scoped", "approval": "scoped", "operation": {"op": "http", "url": "https://user@api.fixture.invalid/"}, "expect": {"outcome": "deny", "http_requests": 0}},
    {"id": "http-ip-literal", "package": "scoped", "approval": "scoped", "operation": {"op": "http", "url": "https://127.0.0.1/"}, "expect": {"outcome": "deny", "http_requests": 0}},
    {"id": "http-private-dns", "package": "scoped", "approval": "scoped", "dns": ["127.0.0.1", "::1"], "operation": {"op": "http", "url": "https://api.fixture.invalid/"}, "expect": {"outcome": "deny", "http_requests": 0}},
    {"id": "http-redirect-egress", "package": "scoped", "approval": "scoped", "redirect": "https://attacker.invalid/", "operation": {"op": "http", "url": "https://api.fixture.invalid/"}, "expect": {"outcome": "deny-or-return-redirect", "http_requests": 1, "redirect_requests": 0}},
    {"id": "http-body-limit", "package": "scoped", "approval": "scoped", "operation": {"op": "http", "url": "https://api.fixture.invalid/", "bytes": 17}, "expect": {"outcome": "deny", "http_requests": 0}},
    {"id": "http-request-budget", "package": "scoped", "approval": "scoped", "operation": {"op": "http", "url": "https://api.fixture.invalid/", "repeat": 3}, "expect": {"outcome": "deny", "http_requests": 2}},
    {"id": "credential-opaque-http", "package": "scoped", "approval": "scoped", "operation": {"op": "http", "url": "https://api.fixture.invalid/", "provider": "fixture", "account": "account-a"}, "expect": {"outcome": "allow", "http_requests": 1, "credential_injected": true, "guest_contains_secret": false}},
    {"id": "credential-egress", "package": "scoped", "approval": "scoped", "operation": {"op": "http", "url": "https://other.fixture.invalid/", "provider": "fixture", "account": "account-a"}, "expect": {"outcome": "deny", "http_requests": 0, "guest_contains_secret": false}},
    {"id": "credential-undeclared", "package": "denied", "approval": "scoped", "operation": {"op": "lease", "provider": "fixture", "account": "account-a"}, "expect": {"outcome": "deny", "guest_contains_secret": false}},
    {"id": "credential-unapproved", "package": "over-permission", "approval": "none", "operation": {"op": "lease", "provider": "fixture", "account": "account-a"}, "expect": {"outcome": "deny", "guest_contains_secret": false}},
    {"id": "credential-opaque-lease", "package": "scoped", "approval": "scoped", "operation": {"op": "lease", "provider": "fixture", "account": "account-a"}, "expect": {"outcome": "allow", "guest_contains_secret": false}},
    {"id": "credential-revoked", "package": "scoped", "approval": "scoped", "revoked_credential": true, "operation": {"op": "lease", "provider": "fixture", "account": "account-a"}, "expect": {"outcome": "deny", "guest_contains_secret": false}},
    {"id": "credential-redirect-egress", "package": "scoped", "approval": "scoped", "redirect": "https://other.fixture.invalid/", "operation": {"op": "http", "url": "https://api.fixture.invalid/", "provider": "fixture", "account": "account-a"}, "expect": {"outcome": "deny-or-return-redirect", "http_requests": 1, "redirect_requests": 0, "guest_contains_secret": false}},
    {"id": "credential-forged-handle", "package": "scoped", "approval": "scoped", "operation": {"op": "http", "url": "https://api.fixture.invalid/", "named": "lease_forged_or_from_another_plugin"}, "expect": {"outcome": "deny", "http_requests": 0, "guest_contains_secret": false}},
    {"id": "credential-other-account", "package": "over-permission", "approval": "plaintext", "operation": {"op": "read", "provider": "fixture", "account": "account-b"}, "expect": {"outcome": "deny", "guest_contains_secret": false}},
    {"id": "credential-other-scope", "package": "over-permission", "approval": "plaintext", "operation": {"op": "read", "provider": "other", "account": "account-a"}, "expect": {"outcome": "deny", "guest_contains_secret": false}},
    {"id": "plaintext-undeclared", "package": "scoped", "approval": "plaintext", "operation": {"op": "read", "provider": "fixture", "account": "account-a"}, "expect": {"outcome": "deny", "guest_contains_secret": false}},
    {"id": "plaintext-unapproved", "package": "over-permission", "approval": "scoped", "operation": {"op": "read", "provider": "fixture", "account": "account-a"}, "expect": {"outcome": "deny", "guest_contains_secret": false}},
    {"id": "plaintext-explicit", "package": "over-permission", "approval": "plaintext", "operation": {"op": "read", "provider": "fixture", "account": "account-a"}, "expect": {"outcome": "allow", "guest_contains_secret": true}},
    {"id": "sign-no-plaintext", "package": "scoped", "approval": "scoped", "operation": {"op": "sign", "url": "https://api.fixture.invalid/", "provider": "fixture", "account": "account-a"}, "expect": {"outcome": "deny-or-opaque", "guest_contains_secret": false}},
    {"id": "storage-zero", "package": "denied", "approval": "scoped", "operation": {"op": "put", "key": "state", "bytes": 1}, "expect": {"outcome": "deny", "storage_changed": false}},
    {"id": "storage-unapproved", "package": "scoped", "approval": "none", "operation": {"op": "put", "key": "state", "bytes": 1}, "expect": {"outcome": "deny", "storage_changed": false}},
    {"id": "storage-at-limit", "package": "scoped", "approval": "scoped", "operation": {"op": "put", "key": "state", "bytes": 16}, "expect": {"outcome": "allow", "storage_changed": true}},
    {"id": "storage-over-limit", "package": "scoped", "approval": "scoped", "operation": {"op": "put", "key": "state", "bytes": 17}, "expect": {"outcome": "deny", "storage_changed": false}},
    {"id": "storage-aggregate", "package": "scoped", "approval": "scoped", "initial_storage": {"existing": [1]}, "operation": {"op": "put", "key": "state", "bytes": 16}, "expect": {"outcome": "deny", "storage_changed": false}},
    {"id": "storage-replacement", "package": "scoped", "approval": "scoped", "initial_storage": {"state": [1]}, "operation": {"op": "put", "key": "state", "bytes": 16}, "expect": {"outcome": "allow", "storage_changed": true}},
    {"id": "storage-entry-limit", "package": "scoped", "approval": "scoped", "initial_storage_entries": 1024, "operation": {"op": "put", "key": "state", "bytes": 1}, "expect": {"outcome": "deny", "storage_changed": false}},
    {"id": "storage-key-limit", "package": "scoped", "approval": "scoped", "operation": {"op": "put", "key": "state", "key_repeat": 52, "bytes": 1}, "expect": {"outcome": "deny", "storage_changed": false}},
    {"id": "storage-isolation", "package": "scoped", "approval": "scoped", "operation": {"op": "get", "key": "shared"}, "expect": {"outcome": "allow", "detail_code": "null", "storage_changed": false}},
    {"id": "storage-path-is-data", "package": "scoped", "approval": "scoped", "operation": {"op": "get", "key": "../../etc/passwd"}, "expect": {"outcome": "allow", "detail_code": "null", "storage_changed": false}},
    {"id": "storage-reserved-put", "package": "scoped", "approval": "scoped", "operation": {"op": "put", "key": "_cache:fixture", "bytes": 1}, "expect": {"outcome": "deny", "storage_changed": false}},
    {"id": "storage-reserved-delete", "package": "scoped", "approval": "scoped", "operation": {"op": "delete", "key": "_config:fixture"}, "expect": {"outcome": "deny", "storage_changed": false}},
    {"id": "cache-outside-refresh", "package": "scoped", "approval": "scoped", "operation": {"op": "cache-set"}, "expect": {"outcome": "deny", "storage_changed": false}},
    {"id": "log-unapproved", "package": "scoped", "approval": "none", "operation": {"op": "log", "message": "fixture marker"}, "expect": {"outcome": "deny-or-drop", "log_records": 0}},
    {"id": "log-redaction", "package": "over-permission", "approval": "plaintext", "operation": {"op": "log", "message": "Authorization: Bearer fixture-secret-not-a-real-credential; refresh_token=fixture-secret-not-a-real-credential"}, "expect": {"outcome": "allow", "log_records": 1, "telemetry_contains_secret": false, "namespaced": true}},
    {"id": "log-bounds", "package": "scoped", "approval": "scoped", "operation": {"op": "log", "message": "x", "message_repeat": 1025, "repeat": 10}, "expect": {"outcome": "allow-or-drop", "max_log_record_bytes": 1024, "max_log_invocation_bytes": 4096}},
    {"id": "error-redaction", "package": "over-permission", "approval": "plaintext", "operation": {"op": "error", "message": "fixture-secret-not-a-real-credential"}, "expect": {"outcome": "error", "telemetry_contains_secret": false, "client_error_contains_secret": false}},
    {"id": "clock-unapproved", "package": "scoped", "approval": "none", "operation": {"op": "clock"}, "expect": {"outcome": "deny"}},
    {"id": "clock-approved", "package": "scoped", "approval": "scoped", "operation": {"op": "clock"}, "expect": {"outcome": "allow", "detail_code": "1700000000123"}}
  ],
  "ambient_imports": [
    {"id": "filesystem", "import": "wasi:filesystem/types@0.2.0", "function": "[method]descriptor.open-at", "operation": {"op": "ambient", "id": "filesystem"}},
    {"id": "host-paths", "import": "wasi:filesystem/preopens@0.2.0", "function": "get-directories", "operation": {"op": "ambient", "id": "host-paths"}},
    {"id": "process-shell", "import": "kinetix:ambient/process-shell", "function": "exec", "operation": {"op": "ambient", "id": "process-shell"}},
    {"id": "environment", "import": "wasi:cli/environment@0.2.0", "function": "get-environment", "operation": {"op": "ambient", "id": "environment"}},
    {"id": "raw-sockets", "import": "wasi:sockets/tcp-create-socket@0.2.0", "function": "create-tcp-socket", "operation": {"op": "ambient", "id": "raw-sockets"}},
    {"id": "arbitrary-network", "import": "wasi:http/outgoing-handler@0.2.0", "function": "handle", "operation": {"op": "ambient", "id": "arbitrary-network"}},
    {"id": "system-credentials", "import": "kinetix:ambient/system-credentials", "function": "read", "operation": {"op": "ambient", "id": "system-credentials"}},
    {"id": "randomness", "import": "wasi:random/random@0.2.0", "function": "get-random-u64", "operation": {"op": "ambient", "id": "randomness"}}
  ]
}
