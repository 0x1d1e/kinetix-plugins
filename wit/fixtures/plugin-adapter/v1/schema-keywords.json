{
  "schema_version": 1,
  "description": "One probe per classified tool-schema keyword. Each probe is a property schema under tool parameters.properties.probe; 'root' adds keywords beside properties; 'at' names where the keyword is observed (probe, default, or root). A nested $id changes reference scope and is rejected by ref-inlining profiles, so $id is probed at the root. Probes must stay disjoint so each keyword's disposition is observable on its own. A probe whose keyword is normalized carries 'normalized', the exact schema expected at properties.probe, and 'lossy': true when the rewrite widens the schema so strict mode must refuse it. Consume is intentional disappearance; normalize is semantic replacement and is asserted by shape.",
  "keywords": {
    "minLength": {"schema": {"type": "string", "minLength": 3}},
    "maxLength": {"schema": {"type": "string", "maxLength": 32}},
    "minProperties": {"schema": {"type": "object", "properties": {"a": {"type": "string"}}, "minProperties": 1}},
    "maxProperties": {"schema": {"type": "object", "properties": {"a": {"type": "string"}}, "maxProperties": 4}},
    "minItems": {"schema": {"type": "array", "items": {"type": "string"}, "minItems": 1}},
    "maxItems": {"schema": {"type": "array", "items": {"type": "string"}, "maxItems": 4}},
    "uniqueItems": {"schema": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}},
    "exclusiveMinimum": {"schema": {"type": "number", "exclusiveMinimum": 1}},
    "exclusiveMaximum": {"schema": {"type": "number", "exclusiveMaximum": 9}},
    "multipleOf": {"schema": {"type": "number", "multipleOf": 2}},
    "format": {"schema": {"type": "string", "format": "uri"}},
    "patternProperties": {"schema": {"type": "object", "properties": {"a": {"type": "string"}}, "patternProperties": {"^x": {"type": "string"}}}},
    "prefixItems": {"schema": {"type": "array", "prefixItems": [{"type": "string"}, {"type": "integer"}]}, "normalized": {"type": "array", "items": {}}, "lossy": true},
    "additionalItems": {"schema": {"type": "array", "items": [{"type": "string"}], "additionalItems": {"type": "integer"}}, "normalized": {"type": "array", "items": {"anyOf": [{"type": "string"}, {"type": "integer"}]}}, "lossy": true},
    "allOf": {"schema": {"allOf": [{"type": "object", "properties": {"a": {"type": "string"}}}, {"required": ["a"]}]}, "normalized": {"type": "object", "properties": {"a": {"type": "string"}}, "required": ["a"]}},
    "oneOf": {"schema": {"oneOf": [{"type": "string"}, {"type": "integer"}]}, "normalized": {"anyOf": [{"type": "string"}, {"type": "integer"}]}},
    "$ref": {"schema": {"$ref": "#/$defs/probe_def"}, "root": {"$defs": {"probe_def": {"type": "string"}}}, "normalized": {"type": "string"}},
    "$defs": {"schema": {"$ref": "#/$defs/probe_def"}, "root": {"$defs": {"probe_def": {"type": "string"}}}, "at": "root", "normalized": {"type": "string"}},
    "definitions": {"schema": {"$ref": "#/definitions/probe_def"}, "root": {"definitions": {"probe_def": {"type": "string"}}}, "at": "root", "normalized": {"type": "string"}},
    "not": {"schema": {"not": {"type": "null"}}},
    "if": {"schema": {"if": {"type": "string"}, "then": {"type": "string"}, "else": {"type": "integer"}}},
    "then": {"schema": {"if": {"type": "string"}, "then": {"type": "string"}, "else": {"type": "integer"}}},
    "else": {"schema": {"if": {"type": "string"}, "then": {"type": "string"}, "else": {"type": "integer"}}},
    "propertyNames": {"schema": {"type": "object", "properties": {"a": {"type": "string"}}, "propertyNames": {"pattern": "^a"}}},
    "contains": {"schema": {"type": "array", "items": {"type": "string"}, "contains": {"type": "string"}}},
    "minContains": {"schema": {"type": "array", "items": {"type": "string"}, "contains": {"type": "string"}, "minContains": 1}},
    "maxContains": {"schema": {"type": "array", "items": {"type": "string"}, "contains": {"type": "string"}, "maxContains": 2}},
    "unevaluatedItems": {"schema": {"type": "array", "items": {"type": "string"}, "unevaluatedItems": false}},
    "unevaluatedProperties": {"schema": {"type": "object", "properties": {"a": {"type": "string"}}, "unevaluatedProperties": false}},
    "dependentSchemas": {"schema": {"type": "object", "properties": {"a": {"type": "string"}, "b": {"type": "string"}}, "dependentSchemas": {"a": {"required": ["b"]}}}},
    "dependentRequired": {"schema": {"type": "object", "properties": {"a": {"type": "string"}, "b": {"type": "string"}}, "dependentRequired": {"a": ["b"]}}},
    "dependencies": {"schema": {"type": "object", "properties": {"a": {"type": "string"}, "b": {"type": "string"}}, "dependencies": {"a": ["b"]}}},
    "$schema": {"schema": {"type": "string", "$schema": "https://json-schema.org/draft/2020-12/schema"}},
    "$comment": {"schema": {"type": "string", "$comment": "probe"}},
    "$id": {"schema": {"type": "string"}, "root": {"$id": "urn:probe"}, "at": "root"},
    "$anchor": {"schema": {"type": "string", "$anchor": "probe"}},
    "strict": {"schema": {"type": "string", "strict": true}},
    "encrypted": {"schema": {"type": "string", "encrypted": true}},
    "default": {"schema": {"type": "string", "default": "x"}},
    "examples": {"schema": {"type": "string", "examples": ["x"]}},
    "example": {"schema": {"type": "string", "example": "x"}},
    "deprecated": {"schema": {"type": "string", "deprecated": true}},
    "readOnly": {"schema": {"type": "string", "readOnly": true}},
    "writeOnly": {"schema": {"type": "string", "writeOnly": true}}
  }
}
