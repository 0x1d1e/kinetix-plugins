{
  "schema_version": 1,
  "strategy": "antigravity-oauth",
  "provider_id": "antigravity",
  "account_id": "conformance-account",
  "credential_template": {
    "access_token": "$access_token",
    "refresh_token": "$refresh_token",
    "expiry": "$expiry_rfc3339",
    "project_id": "conformance-project"
  },
  "refresh": {
    "url": "https://oauth2.googleapis.com/token",
    "encoding": "form",
    "refresh_token_field": "refresh_token"
  },
  "state": {
    "key_prefix": "cred:",
    "access_token": "/access_token",
    "refresh_token": "/refresh_token",
    "expiry": {"pointer": "/expiry", "encoding": "rfc3339"}
  },
  "lease_key_prefix": "lease:",
  "policy": {
    "refresh_lead_ms": 300000,
    "missing_expiry_on_stored_token": "refresh",
    "missing_expires_in": {"default_ttl_secs": 3600}
  }
}
