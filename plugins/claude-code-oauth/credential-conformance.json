{
  "schema_version": 1,
  "strategy": "claude-code-oauth",
  "provider_id": "claude-code",
  "account_id": "conformance-account",
  "credential_template": {
    "access_token": "$access_token",
    "refresh_token": "$refresh_token",
    "expires_at_ms": "$expires_at_ms"
  },
  "refresh": {
    "url": "https://api.anthropic.com/v1/oauth/token",
    "encoding": "json",
    "refresh_token_field": "refresh_token"
  },
  "state": {
    "key_prefix": "cred:",
    "access_token": "/access_token",
    "refresh_token": "/refresh_token",
    "expiry": {"pointer": "/expires_at_ms", "encoding": "unix_ms"}
  },
  "lease_key_prefix": "lease:",
  "policy": {
    "refresh_lead_ms": 14400000,
    "missing_expiry_on_stored_token": "trust",
    "missing_expires_in": "none"
  }
}
