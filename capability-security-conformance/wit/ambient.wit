package kinetix:security-fixture;

// Bindings use upstream WASI definitions, never hand-built instance types.
world ambient {
  include kinetix:plugin/plugin@1.0.0;
  import wasi:filesystem/types@0.2.0;
  import wasi:filesystem/preopens@0.2.0;
  import wasi:sockets/tcp-create-socket@0.2.0;
  import wasi:http/outgoing-handler@0.2.0;
  import wasi:cli/environment@0.2.0;
  import wasi:random/random@0.2.0;
  import kinetix:ambient/process-shell;
  import kinetix:ambient/system-credentials;
}
